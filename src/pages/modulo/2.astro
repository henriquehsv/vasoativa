---
import '../../styles/global.css';

const titulo = "Como reconhecer o choque?";

const navLinks = [
  { name: "Início", href: "/" },
  { name: "Conteúdo", href: "/#conteudo" },
  { name: "Casos Clínicos", href: "/modulo/9" },
  { name: "Algoritmo de Decisão", href: "#" },
  { name: "Sobre", href: "#" },
];

// Classes reutilizadas
const p = "text-lg text-slate-700 leading-relaxed mb-5";
const h2 = "text-2xl font-bold text-slate-900 tracking-tight mt-12 mb-4";
const h3 = "text-xl font-bold text-slate-900 tracking-tight mt-8 mb-3";
const formula = "bg-white border border-slate-100 border-l-4 border-l-teal-600 rounded-r-2xl shadow-sm px-5 py-4 my-6 text-base sm:text-lg font-semibold text-slate-900 overflow-x-auto";
const figWrap = "bg-white p-3 rounded-2xl border border-slate-100 shadow-sm";
const figCap = "mt-3 text-sm text-slate-500 leading-relaxed";
const tabWrap = "overflow-x-auto bg-white rounded-2xl border border-slate-100 shadow-sm my-8";
const th = "px-5 py-3 font-semibold";
const td = "px-5 py-4";

const sinais = [
  { sistema: "Neurológico", achados: "Rebaixamento do nível de consciência, agitação, confusão" },
  { sistema: "Cardiovascular", achados: "Hipotensão, taquicardia, extremidades frias" },
  { sistema: "Renal", achados: "Oligúria (< 0,5 ml/kg/h)" },
  { sistema: "Cutâneo", achados: "Pele fria, sudorese, tempo de enchimento capilar prolongado" },
  { sistema: "Metabólico", achados: "Hiperlactatemia, acidose metabólica" },
];

const classificacaoSI = [
  { valor: "< 0,6", leitura: "Sem evidência de choque pelos parâmetros do índice", cor: "bg-emerald-50 text-emerald-800" },
  { valor: "0,6–1,0", leitura: "Possível comprometimento hemodinâmico", cor: "bg-amber-50 text-amber-800" },
  { valor: "1,0–1,4", leitura: "Maior probabilidade de instabilidade circulatória", cor: "bg-orange-50 text-orange-800" },
  { valor: "≥ 1,4", leitura: "Comprometimento hemodinâmico grave", cor: "bg-red-50 text-red-800" },
];

const mottling = [
  { escore: "0", extensao: "Ausência de mottling" },
  { escore: "1", extensao: "Pequena área central sobre o joelho" },
  { escore: "2", extensao: "Não ultrapassa a borda superior da patela" },
  { escore: "3", extensao: "Estende-se até a metade da coxa" },
  { escore: "4", extensao: "Estende-se até a região inguinal" },
  { escore: "5", extensao: "Ultrapassa a região inguinal" },
];

const referencias = [
  { a: "AIT-OUFELLA, H. et al. The skin mottling score is associated with survival in septic shock.", r: "Intensive Care Medicine", d: ", v. 37, n. 5, p. 801-807, 2011." },
  { a: "AIT-OUFELLA, H.; BOURCIER, S.; ALVES, M.; GALBOIS, A.; BAUDEL, J. L.; MARGETIS, D. et al. Alteration of skin perfusion in mottling area during septic shock.", r: "Annals of Intensive Care", d: ", v. 3, n. 1, p. 31, 2013.", doi: "10.1186/2110-5820-3-31" },
  { a: "ALSAGAFF, Mochamad Yusuf et al. Shock index in the emergency department as a predictor for mortality in COVID-19 patients: a systematic review and meta-analysis.", r: "Heliyon", d: ", v. 9, n. 8, e18553, 2023.", doi: "10.1016/j.heliyon.2023.e18553" },
  { a: "ANDROMEDA-SHOCK-2 INVESTIGATORS. Personalized hemodynamic resuscitation targeting capillary refill time in early septic shock: the ANDROMEDA-SHOCK-2 randomized clinical trial.", r: "JAMA", d: ", Chicago, v. 334, n. 22, p. 1988-1999, 2025." },
  { a: "CARSETTI, Andrea et al. Shock index as predictor of massive transfusion and mortality in patients with trauma: a systematic review and meta-analysis.", r: "Critical Care", d: ", v. 27, art. 85, 2023.", doi: "10.1186/s13054-023-04386-w" },
  { a: "DARMON, Michael; SCHMIDT, Gregory A. What is new and different in the 2021 Surviving Sepsis Campaign guidelines.", r: "Medizinische Klinik Intensivmedizin und Notfallmedizin", d: ", Berlin, v. 118, p. 447-455, 2023." },
  { a: "DE BACKER, D.; HERNÁNDEZ, G. Monitoring the microcirculation in sepsis.", r: "Current Opinion in Critical Care", d: ", v. 25, n. 3, p. 267-272, 2019." },
  { a: "DIAZTAGLE FERNÁNDEZ, Juan José et al. Assessment of the shock index in septic shock: a systematic review.", r: "Medicina Intensiva", d: ", v. 48, n. 11, p. e10-e19, 2024.", doi: "10.1016/j.medine.2024.07.006" },
  { a: "DOURAUD, A. et al. Peripheral perfusion monitoring in critically ill patients: current evidence and future perspectives.", r: "Annals of Intensive Care", d: ", v. 14, n. 1, 2024." },
  { a: "EVANS, Laura et al. Surviving Sepsis Campaign: International Guidelines for Management of Sepsis and Septic Shock 2021.", r: "Critical Care Medicine", d: ", Philadelphia, v. 49, n. 11, p. e1063-e1143, 2021." },
  { a: "GALBOIS, Arnaud; BIGÉ, Naïke; PICHEREAU, Claire; BOËLLE, Pierre-Yves; BAUDEL, Jean-Luc; BOURCIER, Simon; MAURY, Eric; GUIDET, Bertrand; AIT-OUFELLA, Hafid. Exploration of skin perfusion in cirrhotic patients with septic shock.", r: "Journal of Hepatology", d: ", Amsterdam, v. 62, n. 3, p. 549-555, mar. 2015.", doi: "10.1016/j.jhep.2014.10.012" },
  { a: "HERNÁNDEZ, Glenn et al. Effect of a resuscitation strategy targeting peripheral perfusion status versus serum lactate levels on 28-day mortality among patients with septic shock: the ANDROMEDA-SHOCK randomized clinical trial.", r: "JAMA", d: ", Chicago, v. 321, n. 7, p. 654-664, 2019." },
  { a: "LIMA, M. R. et al. Diastolic shock index: a novel prognostic parameter unveiling insights into vasodilatory cardiogenic shock.", r: "European Heart Journal", d: ", v. 45, supl. 1, 2024.", doi: "10.1093/eurheartj/ehae666.1734" },
  { a: "VANG, Malene; ØSTBERG, Maria; STEINMETZ, Jacob; RASMUSSEN, Lars S. Shock index as a predictor for mortality in trauma patients: a systematic review and meta-analysis.", r: "European Journal of Trauma and Emergency Surgery", d: ", v. 48, n. 4, p. 2559-2566, 2022.", doi: "10.1007/s00068-022-01932-z" },
  { a: "YOON, Seo Hee; SHIN, Sang-Jun; KIM, Heeyeon; ROH, Yun Ho. Shock index and shock index, pediatric age-adjusted as predictors of mortality in pediatric patients with trauma: a systematic review and meta-analysis.", r: "PLOS ONE", d: ", v. 19, 2024.", doi: "10.1371/journal.pone.0307367" },
];
---

<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{titulo} - VASOATIVA</title>
    <meta
      name="description"
      content="Sinais, sintomas e parâmetros clínicos para identificação do choque: índice de choque, perfusão tecidual e escala de mottling."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-slate-50 font-['Inter',sans-serif] text-slate-800 antialiased min-h-screen">
    <!-- NAVIGATION -->
    <header class="bg-white border-b border-slate-100 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
          <span class="text-2xl font-bold tracking-tight text-slate-900">
            VASO<span class="text-teal-600">ATIVA</span>
          </span>
          <span class="hidden sm:inline-block text-xs font-semibold tracking-wider text-teal-700 bg-teal-50 px-2.5 py-1 rounded-full uppercase ml-2">
            Educação em Saúde
          </span>
        </a>

        <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-600">
          {navLinks.map((link) => (
            <a href={link.href} class="hover:text-teal-600 transition-colors py-2 border-b-2 border-transparent hover:border-teal-600">
              {link.name}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-20">
      <a
        href="/#conteudo"
        class="inline-block text-sm font-semibold text-teal-700 hover:text-teal-800 hover:underline focus-visible:outline-2 focus-visible:outline-teal-600 focus-visible:outline-offset-4 mb-6"
      >
        ← Todos os módulos
      </a>

      <article>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight mb-8">
          {titulo}
        </h1>

        <p class={p}>
          O reconhecimento do choque deve basear-se na identificação de sinais clínicos e
          laboratoriais de hipoperfusão tecidual, e não apenas na presença de hipotensão arterial.
          Embora a pressão arterial reduzida seja um achado frequente, alguns pacientes podem
          apresentar perfusão inadequada mesmo com níveis pressóricos aparentemente normais,
          especialmente nas fases iniciais do processo.
        </p>

        <div class={tabWrap}>
          <table class="w-full min-w-[30rem] text-left text-sm">
            <caption class="sr-only">Achados sugestivos de choque, por sistema</caption>
            <thead class="bg-teal-50 text-teal-800">
              <tr>
                <th scope="col" class={th}>Sistema</th>
                <th scope="col" class={th}>Achados sugestivos de choque</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {sinais.map((s) => (
                <tr class="align-top">
                  <th scope="row" class={`${td} font-semibold text-slate-900`}>{s.sistema}</th>
                  <td class={`${td} text-slate-600`}>{s.achados}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2 class={h2}>Índice de choque</h2>

        <p class={p}>
          A identificação precoce do choque é um dos principais desafios. Nesse contexto,
          ferramentas simples, rápidas e disponíveis à beira-leito podem auxiliar na identificação
          de pacientes com maior risco de instabilidade circulatória.
        </p>

        <p class={p}>
          O Índice de Choque (<em>Shock Index</em> – SI) é uma delas, um instrumento clínico
          simples que relaciona a frequência cardíaca (FC) à pressão arterial sistólica (PAS). Seu
          objetivo é integrar dois parâmetros fisiológicos facilmente obtidos, permitindo uma
          avaliação mais dinâmica do estado cardiovascular do que a análise isolada de cada
          variável. O SI tem sido estudado em diferentes cenários, incluindo trauma, hemorragia,
          sepse, atendimento pré-hospitalar e emergência (Carsetti et al., 2023; Diaztagle
          Fernández et al., 2024).
        </p>

        <p class={p}>
          Embora tenha sido originalmente desenvolvido como um marcador de comprometimento
          circulatório, o SI não deve ser interpretado como um diagnóstico de choque. Seu maior
          valor está na estratificação inicial de risco, na identificação de alterações
          hemodinâmicas que podem não ser evidentes pela pressão arterial isoladamente e no
          acompanhamento da evolução do paciente.
        </p>

        <h2 class={h2}>Como calcular e interpretar</h2>

        <p class={p}>
          O Índice de Choque é calculado pela razão entre a frequência cardíaca e a pressão
          arterial sistólica:
        </p>

        <p class={formula}>SI = Frequência cardíaca (bpm) ÷ Pressão arterial sistólica (mmHg)</p>

        <p class={p}>Por exemplo, um paciente com frequência cardíaca de 120 bpm e pressão arterial sistólica de 100 mmHg apresenta:</p>

        <p class={formula}>SI = 120 ÷ 100 = 1,2</p>

        <p class={p}>O resultado é um índice adimensional, ou seja, não possui unidade específica.</p>

        <p class={p}>
          Em adultos saudáveis, valores tradicionalmente descritos situam-se aproximadamente entre
          0,5 e 0,7. À medida que o índice aumenta, sugere-se maior comprometimento da relação
          entre frequência cardíaca e pressão arterial sistólica. Valores próximos ou superiores a
          1,0 devem chamar atenção para possível instabilidade hemodinâmica, especialmente quando
          acompanhados de outros sinais de hipoperfusão (Carsetti et al., 2023). É importante,
          entretanto, evitar a interpretação rígida de um único ponto de corte. O valor do SI deve
          ser contextualizado de acordo com idade, condições clínicas, medicamentos em uso,
          presença de arritmias, temperatura, dor, ansiedade e características do tipo de choque.
        </p>

        <p class={p}>
          Uma classificação tradicional do SI utilizada principalmente no contexto do choque
          hipovolêmico considera:
        </p>

        <div class={tabWrap}>
          <table class="w-full min-w-[28rem] text-left text-sm">
            <caption class="sr-only">Classificação tradicional do índice de choque</caption>
            <thead class="bg-teal-50 text-teal-800">
              <tr>
                <th scope="col" class={th}>Índice de choque</th>
                <th scope="col" class={th}>Interpretação</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {classificacaoSI.map((c) => (
                <tr class="align-top">
                  <th scope="row" class={`${td} whitespace-nowrap`}>
                    <span class={`inline-block rounded-full px-3 py-1 font-bold ${c.cor}`}>{c.valor}</span>
                  </th>
                  <td class={`${td} text-slate-600`}>{c.leitura}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class={p}>
          Essa classificação deve ser utilizada como referência didática, e não como um sistema
          diagnóstico definitivo. A literatura contemporânea demonstra heterogeneidade importante
          nos pontos de corte utilizados entre diferentes populações e cenários clínicos (Carsetti
          et al., 2023). Mais importante do que interpretar o número isoladamente é observar sua
          tendência ao longo do tempo.
        </p>

        <p class={p}>Por exemplo, considere dois pacientes:</p>

        <ul class="mb-5 space-y-2 text-lg text-slate-700 leading-relaxed list-disc pl-6 marker:text-teal-600">
          <li><strong class="font-semibold text-slate-900">Paciente A:</strong> FC 110 bpm e PAS 100 mmHg → SI = 1,1</li>
          <li><strong class="font-semibold text-slate-900">Paciente B:</strong> FC 90 bpm e PAS 120 mmHg → SI = 0,75</li>
        </ul>

        <p class={p}>
          O paciente A apresenta maior alteração na relação entre frequência cardíaca e pressão
          arterial e, portanto, merece investigação mais cuidadosa.
        </p>

        <p class={p}>
          Da mesma maneira, a evolução seriada pode fornecer informações relevantes. Um paciente
          cujo SI passa de 0,7 para 1,1 e posteriormente para 1,3 apresenta uma tendência de
          deterioração que deve ser valorizada, mesmo que a pressão arterial ainda não esteja
          francamente reduzida.
        </p>

        <h2 class={h2}>Trauma</h2>

        <p class={p}>
          O trauma constitui um dos cenários nos quais o SI apresenta maior relevância clínica. Na
          hemorragia aguda, a redução do volume intravascular leva inicialmente à diminuição do
          retorno venoso e do volume sistólico. Como resposta compensatória, ocorre aumento da
          atividade simpática e da frequência cardíaca. Nesse contexto, a combinação de taquicardia
          e redução progressiva da pressão arterial sistólica provoca elevação do SI. Uma revisão
          sistemática e metanálise publicada por Carsetti et al. (2023), envolvendo 35 estudos e
          670.728 pacientes traumatizados, avaliou a capacidade do SI de predizer necessidade de
          transfusão maciça e mortalidade. Para transfusão maciça, o SI apresentou área sob a curva
          (AUC) de 0,85, sensibilidade de 68% e especificidade de 84%. Entretanto, para
          mortalidade, seu desempenho foi consideravelmente inferior, com AUC de aproximadamente
          0,55. Os autores concluíram que o SI pode auxiliar na identificação de pacientes com
          maior risco de necessidade de transfusão, mas não deve ser utilizado isoladamente para
          predizer mortalidade (Carsetti et al., 2023).
        </p>

        <p class={p}>
          Esses achados são importantes porque demonstram uma característica fundamental do SI: sua
          utilidade depende do desfecho que se pretende avaliar. Portanto, um SI elevado em um
          paciente traumatizado deve estimular uma avaliação sistemática da possibilidade de
          hemorragia e hipoperfusão, mas não deve determinar isoladamente a indicação de
          transfusão ou qualquer intervenção terapêutica.
        </p>

        <h2 class={h2}>Sepse e choque séptico</h2>

        <p class={p}>
          Na sepse e no choque séptico, a interpretação do SI torna-se mais complexa.
          Diferentemente do choque hemorrágico, no choque distributivo há alterações profundas do
          tônus vascular, da distribuição do fluxo sanguíneo e da microcirculação. Além disso, a
          resposta cronotrópica pode ser influenciada por medicamentos, disfunção autonômica, idade
          e comorbidades.
        </p>

        <p class={p}>
          Uma revisão sistemática publicada em 2024 avaliou especificamente a utilização do SI em
          pacientes com sepse grave ou choque séptico. Foram incluídos 17 estudos, dos quais 11
          investigaram o SI como preditor de mortalidade. Sete desses estudos identificaram
          diferenças significativas do SI entre sobreviventes e não sobreviventes ou demonstraram
          associação entre a evolução do índice e os desfechos clínicos (Diaztagle Fernández et
          al., 2024).
        </p>

        <p class={p}>
          Esses resultados sugerem que o SI pode ter valor prognóstico na sepse, especialmente
          quando avaliado de forma dinâmica, acompanhando sua evolução durante a ressuscitação.
          Entretanto, a heterogeneidade dos estudos e dos pontos de corte impede que um único valor
          seja utilizado universalmente para definir gravidade ou orientar sozinho o tratamento.
          Assim, diante de um paciente com suspeita de choque séptico, um SI elevado deve ser
          interpretado em conjunto com dados clínicos e laboratoriais, como estado mental,
          temperatura e perfusão periférica, tempo de enchimento capilar, débito urinário, lactato,
          pressão arterial, necessidade de vasopressores e avaliação de disfunção orgânica.
        </p>

        <h2 class={h2}>Variações do índice de choque</h2>

        <p class={p}>
          A simplicidade do SI estimulou o desenvolvimento de diferentes variações destinadas a
          melhorar sua capacidade prognóstica em determinadas populações. O <em>Modified Shock
          Index</em> (MSI) utiliza a pressão arterial média em lugar da pressão arterial sistólica:
        </p>

        <p class={formula}>MSI = Frequência cardíaca ÷ Pressão arterial média</p>

        <p class={p}>
          A utilização da pressão arterial média busca incorporar informações relacionadas tanto à
          pressão sistólica quanto à diastólica.
        </p>

        <h3 class={h3}>Índice de choque diastólico</h3>

        <p class={p}>Outra variação é o <em>Diastolic Shock Index</em> (DSI):</p>

        <p class={formula}>DSI = Frequência cardíaca ÷ Pressão arterial diastólica</p>

        <p class={p}>
          O DSI tem despertado interesse particularmente em pacientes com choque distributivo e
          vasoplegia, pois a pressão arterial diastólica pode fornecer informações relacionadas ao
          tônus arterial e à resistência vascular sistêmica. Uma revisão sistemática publicada em
          2024 sobre choque séptico incluiu o DSI entre as variantes avaliadas do índice de choque,
          reforçando o interesse crescente em medidas que possam fornecer informações adicionais
          sobre o componente vasomotor da instabilidade circulatória (Diaztagle Fernández et al.,
          2024).
        </p>

        <h2 class={h2}>Limitações do índice de choque</h2>

        <p class={p}>
          Apesar de sua simplicidade, o SI apresenta limitações importantes. A primeira é que seus
          componentes podem ser influenciados por diversas condições não relacionadas diretamente
          ao choque. Taquicardia pode ocorrer por dor, febre, ansiedade, hipoxemia, anemia, uso de
          β-agonistas ou outras condições clínicas. Da mesma forma, a pressão arterial pode ser
          modificada por medicamentos anti-hipertensivos, vasopressores, sedativos e alterações
          autonômicas.
        </p>

        <p class={p}>
          Além disso, pacientes em uso de betabloqueadores podem não desenvolver a taquicardia
          esperada diante de hipovolemia ou choque. Nesses indivíduos, um SI aparentemente normal
          não exclui comprometimento circulatório. A presença de arritmias também pode comprometer
          a interpretação do índice. Em pacientes com fibrilação atrial, por exemplo, a frequência
          cardíaca pode apresentar grande variabilidade, dificultando a utilização de uma medida
          isolada.
        </p>

        <p class={p}>
          Outro ponto fundamental é que o SI não fornece informações diretas sobre débito cardíaco,
          volume intravascular, resistência vascular sistêmica, perfusão microcirculatória ou
          oferta de oxigênio aos tecidos.
        </p>

        <div class="bg-teal-50 border-l-4 border-teal-600 rounded-r-2xl px-5 py-4 my-8">
          <p class="font-semibold text-teal-900 text-lg leading-relaxed">
            SI normal ≠ ausência de choque e SI elevado ≠ diagnóstico definitivo de choque.
          </p>
        </div>

        <p class={p}>
          O índice deve ser utilizado como uma ferramenta de triagem e estratificação, integrada à
          avaliação clínica e à monitorização hemodinâmica.
        </p>

        <p class={p}>
          Após o reconhecimento do estado de choque, a identificação do mecanismo fisiopatológico
          predominante torna-se fundamental para a escolha da estratégia terapêutica mais adequada,
          incluindo reposição volêmica, suporte inotrópico e utilização de drogas vasoativas.
        </p>

        <h2 class={h2}>Avaliação da perfusão tecidual</h2>

        <p class={p}>
          A avaliação da perfusão tecidual constitui um dos pilares do manejo dos pacientes em
          choque, uma vez que a restauração da perfusão adequada representa o principal objetivo
          das intervenções terapêuticas. Tradicionalmente, parâmetros macrocirculatórios, como
          pressão arterial, frequência cardíaca e débito urinário, foram utilizados para orientar a
          ressuscitação hemodinâmica. Entretanto, estudos demonstraram que a normalização dessas
          variáveis não necessariamente se traduz em recuperação da microcirculação e da perfusão
          tecidual, o que impulsionou a busca por marcadores capazes de refletir mais diretamente o
          estado perfusional do paciente (Hernández et al., 2019).
        </p>

        <p class={p}>
          Entre os principais parâmetros utilizados para avaliação da perfusão destacam-se os
          níveis séricos de lactato, o tempo de enchimento capilar (TEC), o débito urinário, a
          temperatura periférica e o estado neurológico. O lactato sérico permanece como um dos
          biomarcadores mais estudados e utilizados na prática clínica, estando associado à
          gravidade da doença e ao prognóstico dos pacientes críticos. No entanto, sua elevação não
          está necessariamente relacionada à hipóxia tecidual, podendo ocorrer em situações como
          disfunção hepática, uso de catecolaminas e alterações metabólicas diversas. Dessa forma,
          recomenda-se que sua interpretação seja realizada de forma integrada aos demais
          parâmetros clínicos e hemodinâmicos (Darmon; Schmidt, 2023; Evans et al., 2021).
        </p>

        <h3 class={h3}>ANDROMEDA-SHOCK e ANDROMEDA-SHOCK-2</h3>

        <p class={p}>
          Um marco importante na avaliação da perfusão tecidual foi o estudo ANDROMEDA-SHOCK,
          publicado por Hernández et al. (2019), que comparou uma estratégia de ressuscitação
          guiada pelo tempo de enchimento capilar com uma estratégia baseada na redução dos níveis
          séricos de lactato em pacientes com choque séptico. Embora o estudo não tenha
          demonstrado diferença estatisticamente significativa na mortalidade em 28 dias,
          observou-se tendência à redução da mortalidade e menor grau de disfunção orgânica no
          grupo guiado pela perfusão periférica. Os autores concluíram que o tempo de enchimento
          capilar constitui um marcador simples, acessível e responsivo para monitorização da
          ressuscitação hemodinâmica, reforçando o conceito de que a avaliação da perfusão
          periférica pode representar um alvo terapêutico relevante (Hernández et al., 2019).
        </p>

        <p class={p}>
          Mais recentemente, o estudo ANDROMEDA-SHOCK-2 ampliou essa abordagem ao investigar uma
          estratégia de ressuscitação hemodinâmica personalizada baseada na avaliação da perfusão
          periférica. Além do tempo de enchimento capilar, foram incorporados parâmetros como
          pressão arterial diastólica, pressão de pulso, responsividade a fluidos e ecocardiografia
          à beira do leito para orientar intervenções individualizadas. Os resultados reforçaram a
          importância da identificação precoce dos diferentes perfis hemodinâmicos presentes no
          choque séptico, permitindo uma abordagem terapêutica mais direcionada e potencialmente
          reduzindo intervenções desnecessárias (ANDROMEDA-SHOCK-2 Investigators, 2025).
        </p>

        <p class={p}>
          Os achados desses estudos contribuíram para consolidar o conceito de ressuscitação
          personalizada, atualmente incorporado às discussões contemporâneas sobre o manejo do
          choque. Nesse contexto, a avaliação integrada da perfusão tecidual torna-se fundamental
          não apenas para o reconhecimento da gravidade do quadro clínico, mas também para orientar
          decisões terapêuticas relacionadas à administração de fluidos, ao uso de vasopressores e
          à introdução de agentes inotrópicos. Dessa forma, a compreensão dos diferentes
          marcadores de perfusão constitui etapa essencial para a utilização racional das drogas
          vasoativas no paciente crítico (ANDROMEDA-SHOCK-2 Investigators, 2025; Evans et al.,
          2021).
        </p>

        <h2 class={h2}>Escala de mottling</h2>

        <p class={p}>
          Outra forma de avaliação da perfusão tecidual pelo exame físico é a escala <em>mottling</em>.
          O <em>mottling</em> corresponde a uma alteração cutânea caracterizada por manchas
          irregulares de coloração violácea ou marmorizada, geralmente observadas na região dos
          joelhos e membros inferiores, resultantes de alterações da microcirculação e da perfusão
          periférica. Sua presença tem sido associada à gravidade do choque circulatório e à pior
          evolução clínica, especialmente em pacientes com choque séptico (Ait-Oufella et al.,
          2011; De Backer; Hernández, 2019).
        </p>

        <p class={p}>
          Com o objetivo de padronizar sua avaliação clínica, Ait-Oufella et al. (2011)
          desenvolveram o <em>Mottling Score</em>, um sistema de classificação que varia de 0 a 5
          de acordo com a extensão da marmorização cutânea ao redor do joelho. Estudos
          subsequentes demonstraram que escores mais elevados estão associados a maior
          mortalidade e maior gravidade da disfunção orgânica, independentemente de outros
          marcadores hemodinâmicos (Ait-Oufella et al., 2011; Douraud et al., 2024).
        </p>

        <p class={p}>
          A importância do <em>mottling</em> decorre do fato de representar um marcador clínico da
          microcirculação. Diferentemente dos parâmetros macrocirculatórios, como pressão arterial
          e frequência cardíaca, a avaliação da perfusão periférica permite identificar pacientes
          que permanecem hipoperfundidos mesmo após aparente estabilização hemodinâmica. Essa
          dissociação entre macrocirculação e microcirculação tem sido amplamente discutida na
          literatura contemporânea e constitui um dos fundamentos da ressuscitação guiada por
          perfusão periférica (De Backer; Hernández, 2019).
        </p>

        <p class={p}>
          Apesar de seu valor prognóstico, algumas limitações devem ser consideradas. A avaliação
          do <em>mottling</em> pode apresentar menor acurácia em indivíduos com fototipos cutâneos
          mais elevados, e sua interpretação pode sofrer influência da experiência do examinador e
          das condições de iluminação do ambiente. Dessa forma, recomenda-se que o <em>Mottling
          Score</em> seja utilizado em conjunto com outros parâmetros clínicos e laboratoriais de
          perfusão tecidual, como o tempo de enchimento capilar e os níveis séricos de lactato
          (Douraud <em>et al.</em>, 2024).
        </p>

        <p class={p}>
          Considerando sua simplicidade, baixo custo e relevância prognóstica, essa estratégia
          representa uma ferramenta complementar importante na avaliação do paciente em choque,
          contribuindo para a identificação precoce da hipoperfusão tecidual e para o
          monitoramento da resposta às intervenções terapêuticas.
        </p>

