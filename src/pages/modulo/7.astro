const td = "px-5 py-4";
const titulo = "Vasodilatadores";
const subtitulo = "Mecanismos de ação e efeitos hemodinâmicos";

const classes = [
  { classe: "Doadores de óxido nítrico", exemplos: "Nitroglicerina e nitroprussiato de sódio" },
  { classe: "Bloqueadores dos canais de cálcio di-hidropiridínicos", exemplos: "Nicardipina e clevidipina intravenosas" },
  { classe: "Vasodilatadores de ação direta", exemplos: "Hidralazina" },
];

const legendaPam = [
  { sigla: "PAM", texto: "pressão arterial média;" },
  { sigla: "PVC", texto: "pressão venosa central;" },
  { sigla: "DC", texto: "débito cardíaco;" },
  { sigla: "RVS", texto: "resistência vascular sistêmica." },
];

const referencias = [
  { a: "CHIONCEL, Ovidiu et al. Pathophysiology and clinical use of agents with vasodilator properties in acute heart failure: a scientific statement of the Heart Failure Association (HFA) of the European Society of Cardiology (ESC).", r: "European Journal of Heart Failure", d: ", v. 27, n. 6, p. 1067–1088, 2025.", doi: "10.1002/ejhf.3673" },
  { a: "HEIDENREICH, Paul A. et al. 2022 AHA/ACC/HFSA guideline for the management of heart failure: a report of the American College of Cardiology/American Heart Association Joint Committee on Clinical Practice Guidelines.", r: "Circulation", d: ", v. 145, n. 18, p. e895–e1032, 2022.", doi: "10.1161/CIR.0000000000001063" },
  { a: "MCEVOY, John W. et al. 2024 ESC Guidelines for the management of elevated blood pressure and hypertension.", r: "European Heart Journal", d: ", v. 45, n. 38, p. 3912–4018, 2024.", doi: "10.1093/eurheartj/ehae178" },
];
---

<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{titulo} - VASOATIVA</title>
    <meta name="description" content="Mecanismos de ação, efeitos hemodinâmicos, principais fármacos, indicações e cuidados no uso de vasodilatadores." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
