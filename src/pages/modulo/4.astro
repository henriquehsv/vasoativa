];

// Classes reutilizadas
const p = "text-lg text-slate-700 leading-relaxed mb-5";
const h2 = "text-2xl font-bold text-slate-900 tracking-tight mt-12 mb-4";
const formula = "bg-white border border-slate-100 border-l-4 border-l-teal-600 rounded-r-2xl shadow-sm px-5 py-4 my-6 text-base sm:text-lg font-semibold text-slate-900 overflow-x-auto";
const figWrap = "bg-white p-3 rounded-2xl border border-slate-100 shadow-sm";
const figCap = "mt-3 text-sm text-slate-500 leading-relaxed";

const titulo = "Os tipos de choque";
const subtitulo = "Categorias e perfis hemodinâmicos";

const referencias = [
  { a: "KHORSAND, S. et al. Not all shock states are created equal: a review of the diagnosis and management of septic, hypovolemic, cardiogenic, obstructive, and distributive shock.", r: "Anesthesiology Clinics", d: ", v. 41, n. 1, p. 1–25, 2023.", doi: "10.1016/j.anclin.2022.11.002" },
  { a: "LAGHLAM, D. et al. Management of cardiogenic shock: a narrative review.", r: "Annals of Intensive Care", d: ", v. 14, n. 1, art. 45, 2024.", doi: "10.1186/s13613-024-01260-y" },
  { a: "MONNET, X.; LAI, C.; OSPINA-TASCÓN, G. A.; DE BACKER, D. Evidence for a personalized early start of norepinephrine in septic shock.", r: "Critical Care", d: ", v. 27, n. 1, art. 322, 2023.", doi: "10.1186/s13054-023-04593-5" },
  { a: "OLIVEIRA, M. D. C. et al. Uncomplicated circulatory shock: a narrative review.", r: "Einstein (São Paulo)", d: ", v. 22, supl. 1, art. eRW0775, 2024.", doi: "10.31744/einstein_journal/2024RW0775" },
  { a: "OSPINA-TASCÓN, G. A. et al. Diastolic shock index and clinical outcomes in patients with septic shock.", r: "Annals of Intensive Care", d: ", v. 10, n. 1, art. 41, 2020.", doi: "10.1186/s13613-020-00658-8" },
  { a: "PERSICHINI, R. et al. Venous return and mean systemic filling pressure: physiology and clinical applications.", r: "Critical Care", d: ", v. 26, n. 1, art. 150, 2022.", doi: "10.1186/s13054-022-04024-x" },
  { a: "STANDL, T. et al. The nomenclature, definition and distinction of types of shock.", r: "Deutsches Ärzteblatt International", d: ", v. 115, n. 45, p. 757–768, 2018.", doi: "10.3238/arztebl.2018.0757" },
];
---

<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{titulo} - VASOATIVA</title>
    <meta name="description" content="Categorias e perfis hemodinâmicos: choque hipovolêmico, cardiogênico, distributivo e obstrutivo." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-slate-50 font-['Inter',sans-serif] text-slate-800 antialiased min-h-screen">
    <!-- NAVIGATION -->
    <header class="bg-white border-b border-slate-100 sticky top-0 z-50">
