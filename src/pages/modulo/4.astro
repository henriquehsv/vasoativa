const titulo = "Os tipos de choque";
const subtitulo = "Categorias e perfis hemodinâmicos";

const referencias = [
  { a: "KHORSAND, Sarah; HELOU, Mada F.; SATYAPRIYA, Veena; KOPANCZYK, Rafal; KHANNA, Ashish K. Not all shock states are created equal: a review of the diagnosis and management of septic, hypovolemic, cardiogenic, obstructive, and distributive shock.", r: "Anesthesiology Clinics", d: ", v. 41, n. 1, p. 1–25, 2023.", doi: "10.1016/j.anclin.2022.11.002" },
  { a: "LAGHLAM, Driss; BENGHANEM, Sarah; ORTUNO, Sofia et al. Management of cardiogenic shock: a narrative review.", r: "Annals of Intensive Care", d: ", v. 14, art. 45, 2024.", doi: "10.1186/s13613-024-01260-y" },
  { a: "MONNET, Xavier; LAI, Christopher; OSPINA-TASCÓN, Gustavo A.; DE BACKER, Daniel. Evidence for a personalized early start of norepinephrine in septic shock.", r: "Critical Care", d: ", London, v. 27, p. 322, 2023.", doi: "10.1186/s13054-023-04593-5" },
  { a: "OLIVEIRA, Mauro Dirlando Conte de; SANTOS, Oscar Fernando Pavão dos; COLOMBO, Giancarlo et al. Uncomplicated circulatory shock: a narrative review.", r: "einstein (São Paulo)", d: ", v. 22, esp. 1, eRW0775, 2024.", doi: "10.31744/einstein_journal/2024RW0775" },
  { a: "OSPINA-TASCÓN, Gustavo A. et al. Effects of very early start of norepinephrine in patients with septic shock: a propensity score-based analysis.", r: "Critical Care", d: ", London, v. 24, n. 1, p. 52, 2020.", doi: "10.1186/s13054-020-2756-3" },
  { a: "STANDL, T.; ANNECKE, T.; CASCORBI, I.; HELLER, A. R.; SABASHNIKOV, A.; TESKE, W. The nomenclature, definition and distinction of types of shock.", r: "Deutsches Ärzteblatt International", d: ", v. 115, n. 45, p. 757–768, 2018.", doi: "10.3238/arztebl.2018.0757" },
];
---

<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
