---
import '../../styles/global.css';
import { casos } from '../../data/casos.js';

const titulo = "Casos clínicos";

const navLinks = [
  { name: "Início", href: "/" },
  { name: "Conteúdo", href: "/#conteudo" },
  { name: "Casos Clínicos", href: "/modulo/9" },
  { name: "Algoritmo de Decisão", href: "#" },
  { name: "Sobre", href: "#" },
];

// Trecho de abertura de cada caso (primeira frase do cenário).
const resumo = (caso) => {
  const p = caso.intro.find((b) => b.tipo === 'p');
  return p ? p.texto.split(/(?<=\.)\s/)[0] : '';
};
---

<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{titulo} - VASOATIVA</title>
    <meta
      name="description"
      content="Casos clínicos simulados para aplicar o conhecimento sobre choque e drogas vasoativas e treinar a tomada de decisão."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-slate-50 font-['Inter',sans-serif] text-slate-800 antialiased min-h-screen">
    <!-- NAVIGATION -->
    <header class="bg-white border-b border-slate-100 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
          <span class="text-2xl font-bold tracking-tight text-slate-900">
            VASO<span class="text-teal-600">ATIVA</span>
          </span>
          <span class="hidden sm:inline-block text-xs font-semibold tracking-wider text-teal-700 bg-teal-50 px-2.5 py-1 rounded-full uppercase ml-2">
            Educação em Saúde
          </span>
        </a>

        <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-600">
          {navLinks.map((link) => (
            <a href={link.href} class="hover:text-teal-600 transition-colors py-2 border-b-2 border-transparent hover:border-teal-600">
              {link.name}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-20">
      <a
        href="/#conteudo"
        class="inline-block text-sm font-semibold text-teal-700 hover:text-teal-800 hover:underline focus-visible:outline-2 focus-visible:outline-teal-600 focus-visible:outline-offset-4 mb-6"
      >
        ← Todos os módulos
      </a>

      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">
        {titulo}
      </h1>
      <p class="text-lg text-slate-600 leading-relaxed mb-10">
        Aplique o que aprendeu nos módulos anteriores. Cada caso tem uma página própria: leia o
        cenário, responda às perguntas na ordem que preferir e veja o gabarito com a explicação
        logo após cada resposta.
      </p>

      <ul class="space-y-4" role="list">
        {casos.map((caso) => (
          <li>
            <a
              href={`/modulo/9/caso-${caso.id}`}
              class="group bg-white p-6 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md hover:border-teal-200 transition-all duration-200 flex items-start gap-5"
            >
              <span class="w-12 h-12 shrink-0 rounded-xl bg-slate-900 text-white font-bold flex items-center justify-center text-base group-hover:bg-teal-600 transition-colors" aria-hidden="true">
                {caso.id}
              </span>
              <div class="flex-1">
                <h2 class="font-bold text-slate-900 group-hover:text-teal-700 transition-colors mb-1 text-lg">
                  Caso clínico {caso.id}
                </h2>
                <p class="text-sm text-slate-500 leading-relaxed mb-3">{resumo(caso)}</p>
                <p class="text-xs font-semibold text-teal-700 uppercase tracking-wide">
                  {caso.perguntas.length} perguntas
                </p>
              </div>
              <span class="shrink-0 self-center text-slate-300 group-hover:text-teal-600 transition-colors text-xl" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>

      <nav class="mt-16 flex flex-wrap items-center justify-between gap-4" aria-label="Módulos">
        <a
          href="/modulo/8"
          class="bg-white hover:bg-slate-50 text-slate-700 font-semibold px-6 py-3.5 rounded-lg border border-slate-200 hover:border-slate-300 transition duration-150"
        >
          Módulo anterior
        </a>
        <a
          href="/modulo/10"
          class="bg-teal-600 hover:bg-teal-700 text-white font-semibold px-6 py-3.5 rounded-lg shadow-sm hover:shadow transition duration-150"
        >
          Próximo módulo
        </a>
      </nav>
    </main>
  </body>
</html>
