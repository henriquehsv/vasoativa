---
import '../../../styles/global.css';
import BlocosCaso from '../../../components/BlocosCaso.astro';
import { casos } from '../../../data/casos.js';

export function getStaticPaths() {
  return casos.map((caso, i) => ({
    params: { caso: `caso-${caso.id}` },
    props: { caso, anterior: casos[i - 1] ?? null, proximo: casos[i + 1] ?? null },
  }));
}

const { caso, anterior, proximo } = Astro.props;

// Se true, a "evolução do caso" (e a pergunta que depende dela) só é liberada depois de
// responder a pergunta anterior. Isso evita que o texto da evolução revele a resposta anterior.
// Mude para false para deixar tudo visível desde o início.
const bloquearEvolucao = true;

const titulo = `Caso clínico ${caso.id}`;
const total = caso.perguntas.length;
const letras = ["A", "B", "C", "D", "E"];
const fmt = (s) => s.replace(/\*(.+?)\*/g, '<em>$1</em>');
const bloqueada = (q) => bloquearEvolucao && Boolean(q.antes && q.antes.length > 0);

const navLinks = [
  { name: "Início", href: "/" },
  { name: "Conteúdo", href: "/#conteudo" },
  { name: "Casos Clínicos", href: "/modulo/9" },
  { name: "Algoritmo de Decisão", href: "#" },
  { name: "Sobre", href: "#" },
];

const chipCore = "w-10 h-10 shrink-0 rounded-lg border-2 font-bold flex items-center justify-center text-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-600";
const chipIdle = "border-slate-200 bg-white text-slate-700 hover:border-teal-400";
const chipLocked = "border-slate-200 bg-slate-100 text-slate-400";
---

<!DOCTYPE html>
<html lang="pt-BR" class="motion-safe:scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{titulo} - Casos clínicos - VASOATIVA</title>
    <meta name="description" content={`${titulo}: cenário e ${total} perguntas para treinar a tomada de decisão no paciente em choque.`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <noscript>
      <style>
        [data-body][hidden], [data-feedback][hidden] { display: block !important; }
        [data-locked-note] { display: none !important; }
      </style>
    </noscript>
  </head>

  <body class="bg-slate-50 font-['Inter',sans-serif] text-slate-800 antialiased min-h-screen">
    <!-- NAVIGATION -->
    <header class="bg-white border-b border-slate-100 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
          <span class="text-2xl font-bold tracking-tight text-slate-900">
            VASO<span class="text-teal-600">ATIVA</span>
          </span>
          <span class="hidden sm:inline-block text-xs font-semibold tracking-wider text-teal-700 bg-teal-50 px-2.5 py-1 rounded-full uppercase ml-2">
            Educação em Saúde
          </span>
        </a>

        <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-600">
          {navLinks.map((link) => (
            <a href={link.href} class="hover:text-teal-600 transition-colors py-2 border-b-2 border-transparent hover:border-teal-600">
              {link.name}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main data-case class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-20">
      <a
        href="/modulo/9"
        class="inline-block text-sm font-semibold text-teal-700 hover:text-teal-800 hover:underline focus-visible:outline-2 focus-visible:outline-teal-600 focus-visible:outline-offset-4 mb-6"
      >
        ← Casos clínicos
      </a>

      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight mb-2">
        {titulo}
      </h1>
      <p class="text-lg text-slate-500 mb-8">{total} perguntas</p>

      <!-- CENÁRIO -->
      <section aria-label="Cenário do caso" class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 sm:p-8">
        <p class="text-xs font-bold tracking-widest text-teal-700 uppercase mb-3">Cenário</p>
        <BlocosCaso blocos={caso.intro} />
      </section>

      <!-- NAVEGADOR DE PERGUNTAS (fixo ao rolar) -->
      <div class="sticky top-20 z-40 -mx-4 sm:mx-0 px-4 sm:px-0 py-3 mt-6 bg-slate-50/90 backdrop-blur">
        <nav aria-label="Perguntas deste caso" class="bg-white border border-slate-100 shadow-sm rounded-2xl px-4 py-3 flex items-center gap-4">
          <span class="hidden sm:inline text-xs font-bold tracking-widest text-slate-500 uppercase shrink-0">Perguntas</span>
          <ol class="flex items-center gap-2 overflow-x-auto py-1 px-1 -mx-1" role="list">
            {caso.perguntas.map((q, qi) => (
              <li class="shrink-0">
                <a
                  href={`#pergunta-${qi + 1}`}
                  data-chip
                  data-goto
                  aria-label={`Pergunta ${qi + 1}: ${bloqueada(q) ? 'bloqueada até responder a pergunta anterior' : 'não respondida'}`}
                  class={`${chipCore} ${bloqueada(q) ? chipLocked : chipIdle}`}
                >
                  {qi + 1}
                </a>
              </li>
            ))}
          </ol>
          <span data-nav-summary class="ml-auto shrink-0 text-sm font-semibold text-teal-700 whitespace-nowrap">0 de {total}</span>
        </nav>
      </div>

      <p class="sr-only" role="status" aria-live="polite" data-live></p>

      <!-- PERGUNTAS -->
      <div class="mt-2 space-y-6">
        {caso.perguntas.map((q, qi) => {
          const locked = bloqueada(q);
          const ultima = qi === total - 1;
          return (
            <article
              id={`pergunta-${qi + 1}`}
              data-question
              data-correct={q.correta}
              data-lockable={locked ? 'true' : 'false'}
              data-locked={locked ? 'true' : 'false'}
              tabindex="-1"
              aria-labelledby={`pergunta-${qi + 1}-titulo`}
              class="scroll-mt-40 bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden focus:outline-none"
            >
              <div class="px-6 sm:px-8 pt-6 flex items-center gap-3">
                <h2 id={`pergunta-${qi + 1}-titulo`} class="text-sm font-bold tracking-widest text-slate-500 uppercase">
                  Pergunta {qi + 1} <span class="text-slate-400">de {total}</span>
                </h2>
                {q.revisar && (
                  <span class="text-xs font-semibold text-amber-800 bg-amber-100 rounded-full px-2.5 py-1">Em revisão</span>
                )}
              </div>

              <div data-locked-note hidden={!locked} class="px-6 sm:px-8 py-6">
                <div class="flex items-center gap-3 rounded-xl border border-dashed border-slate-300 bg-slate-50 px-5 py-4 text-slate-600">
                  <svg aria-hidden="true" viewBox="0 0 20 20" class="w-5 h-5 shrink-0 text-slate-400" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 2a4 4 0 00-4 4v2H5a1 1 0 00-1 1v7a1 1 0 001 1h10a1 1 0 001-1V9a1 1 0 00-1-1h-1V6a4 4 0 00-4-4zm2 6V6a2 2 0 10-4 0v2h4z" clip-rule="evenodd" />
                  </svg>
                  <p>
                    Responda a <a href={`#pergunta-${qi}`} data-goto class="font-semibold text-teal-700 hover:underline">Pergunta {qi}</a>
                    para ver a evolução do caso e liberar esta pergunta.
                  </p>
                </div>
              </div>

              <div data-body hidden={locked} class="px-6 sm:px-8 pt-3 pb-6">
                {q.antes && q.antes.length > 0 && (
                  <div class="mb-6 rounded-xl border-l-4 border-teal-600 bg-teal-50 px-5 py-4">
                    <p class="text-xs font-bold tracking-widest text-teal-700 uppercase mb-2">O caso evolui</p>
                    <BlocosCaso blocos={q.antes} />
                  </div>
                )}

                <div class="mb-5 space-y-3">
                  {q.enunciado.map((par) => (
                    <p class="text-xl font-semibold text-slate-900 leading-snug" set:html={fmt(par)} />
                  ))}
                </div>

                <ul class="space-y-3" role="list">
                  {q.opcoes.map((op, oi) => (
                    <li>
                      <button
                        type="button"
                        data-option
                        data-letter={letras[oi]}
                        class="w-full flex items-start gap-4 text-left rounded-xl border-2 border-slate-200 bg-white px-4 py-4 hover:border-teal-400 hover:bg-teal-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-600 transition-colors"
                      >
                        <span data-badge class="shrink-0 w-8 h-8 rounded-lg bg-slate-100 text-slate-700 font-bold flex items-center justify-center text-sm">
                          {letras[oi]}
                        </span>
                        <span class="flex-1 text-base sm:text-lg text-slate-800 leading-snug pt-0.5">{op}</span>
                        <span data-status hidden class="shrink-0 text-sm font-semibold pt-1"></span>
                      </button>
                    </li>
                  ))}
                </ul>

                <div
                  data-feedback
                  hidden
                  tabindex="-1"
                  class="mt-6 rounded-xl border border-slate-200 bg-slate-50 px-5 py-5 focus:outline-none"
                >
                  <p data-feedback-title class="text-lg font-bold text-slate-900"></p>
                  <p class="mt-1 font-semibold text-slate-900">Gabarito: Alternativa {q.correta}.</p>
                  {q.comentario && q.comentario.length > 0 && (
                    <div class="mt-3 space-y-3 text-slate-700 leading-relaxed">
                      {q.comentario.map((par) => <p set:html={fmt(par)} />)}
                    </div>
                  )}
                  {q.revisar && (
                    <p class="mt-4 text-sm text-amber-900 bg-amber-50 border border-amber-200 rounded-lg px-4 py-3">
                      <strong class="font-semibold">Nota de revisão:</strong> {q.revisar}
                    </p>
                  )}
                  <div class="mt-5">
                    <a
                      href={ultima ? '#resultado' : `#pergunta-${qi + 2}`}
                      data-goto
                      class="inline-block bg-teal-600 hover:bg-teal-700 text-white font-semibold px-6 py-3 rounded-lg shadow-sm hover:shadow transition duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-600"
                    >
                      {ultima ? 'Ver resultado' : `Ir para a Pergunta ${qi + 2}`}
                    </a>
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <!-- RESULTADO -->
      <section
        id="resultado"
        tabindex="-1"
        aria-labelledby="resultado-titulo"
        class="scroll-mt-40 mt-6 bg-white rounded-2xl border border-slate-100 shadow-sm px-6 sm:px-8 py-8 text-center focus:outline-none"
      >
        <h2 id="resultado-titulo" class="text-sm font-bold tracking-widest text-slate-500 uppercase mb-4">Resultado</h2>

        <p data-summary-status class="text-slate-600">
          Responda às perguntas para ver o seu resultado.
        </p>

        <div data-summary-result hidden>
          <p class="text-5xl font-extrabold text-slate-900 mb-3">
            <span data-summary-score>0</span><span class="text-slate-400"> / {total}</span>
          </p>
          <p data-summary-msg class="text-slate-600 max-w-md mx-auto"></p>
        </div>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <button
            type="button"
            data-restart
            hidden
            class="bg-white hover:bg-slate-50 text-slate-700 font-semibold px-6 py-3 rounded-lg border border-slate-200 hover:border-slate-300 transition duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-600"
          >
            Refazer este caso
          </button>
        </div>
      </section>

      <!-- NAVEGAÇÃO ENTRE CASOS -->
      <nav class="mt-10 flex flex-wrap items-center justify-between gap-4" aria-label="Navegação entre casos">
        {anterior ? (
          <a
            href={`/modulo/9/caso-${anterior.id}`}
            class="bg-white hover:bg-slate-50 text-slate-700 font-semibold px-6 py-3.5 rounded-lg border border-slate-200 hover:border-slate-300 transition duration-150"
          >
            ← Caso {anterior.id}
          </a>
        ) : (
          <a
            href="/modulo/9"
            class="bg-white hover:bg-slate-50 text-slate-700 font-semibold px-6 py-3.5 rounded-lg border border-slate-200 hover:border-slate-300 transition duration-150"
          >
            Todos os casos
          </a>
        )}
        {proximo ? (
          <a
            href={`/modulo/9/caso-${proximo.id}`}
            class="bg-teal-600 hover:bg-teal-700 text-white font-semibold px-6 py-3.5 rounded-lg shadow-sm hover:shadow transition duration-150"
          >
            Caso {proximo.id} →
          </a>
        ) : (
          <a
            href="/modulo/9"
            class="bg-teal-600 hover:bg-teal-700 text-white font-semibold px-6 py-3.5 rounded-lg shadow-sm hover:shadow transition duration-150"
          >
            Todos os casos
          </a>
        )}
      </nav>
    </main>

    <script>
      const root = document.querySelector('[data-case]');

      if (root) {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const questions = [...root.querySelectorAll('[data-question]')];
        const chips = [...root.querySelectorAll('[data-chip]')];
        const total = questions.length;
        const live = root.querySelector('[data-live]');
        const navSummary = root.querySelector('[data-nav-summary]');
        const sumStatus = root.querySelector('[data-summary-status]');
        const sumResult = root.querySelector('[data-summary-result]');
        const sumScore = root.querySelector('[data-summary-score]');
        const sumMsg = root.querySelector('[data-summary-msg]');
        const restartBtn = root.querySelector('[data-restart]');

        const CORRECT_OPT = ['border-emerald-500', 'bg-emerald-50'];
        const WRONG_OPT = ['border-red-500', 'bg-red-50'];
        const CORRECT_BADGE = ['bg-emerald-600', 'text-white'];
        const WRONG_BADGE = ['bg-red-600', 'text-white'];
        const FB_OK = ['border-emerald-200', 'bg-emerald-50'];
        const FB_BAD = ['border-red-200', 'bg-red-50'];

        const CHIP_CORE = 'w-10 h-10 shrink-0 rounded-lg border-2 font-bold flex items-center justify-center text-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-600';
        const CHIP = {
          idle: 'border-slate-200 bg-white text-slate-700 hover:border-teal-400',
          correct: 'border-emerald-500 bg-emerald-50 text-emerald-800',
          wrong: 'border-red-500 bg-red-50 text-red-800',
          locked: 'border-slate-200 bg-slate-100 text-slate-400',
        };
        const CHIP_TEXT = {
          idle: 'não respondida',
          correct: 'respondida, correta',
          wrong: 'respondida, incorreta',
          locked: 'bloqueada até responder a pergunta anterior',
        };

        const results = new Array(total).fill(null);
        let score = 0;
        let done = 0;
        let active = -1;

        // Guarda as classes originais para poder refazer o caso.
        const original = new Map();
        root.querySelectorAll('[data-option]').forEach((o) => {
          original.set(o, { opt: o.className, badge: o.querySelector('[data-badge]').className });
        });
        questions.forEach((q) => {
          const fb = q.querySelector('[data-feedback]');
          original.set(fb, { opt: fb.className });
        });

        function renderChip(i) {
          const state = questions[i].dataset.locked === 'true' ? 'locked' : results[i] || 'idle';
          const chip = chips[i];
          chip.className = `${CHIP_CORE} ${CHIP[state]}${i === active ? ' ring-2 ring-teal-500 ring-offset-2' : ''}`;
          chip.setAttribute('aria-label', `Pergunta ${i + 1}: ${CHIP_TEXT[state]}`);
          if (i === active) chip.setAttribute('aria-current', 'true');
          else chip.removeAttribute('aria-current');
        }

        function renderSummary() {
          navSummary.textContent = `${done} de ${total}`;
          restartBtn.hidden = done === 0;
          if (done === total) {
            sumStatus.hidden = true;
            sumResult.hidden = false;
            sumScore.textContent = String(score);
            const ratio = score / total;
            sumMsg.textContent =
              ratio === 1
                ? 'Excelente! Você acertou todas as perguntas deste caso.'
                : ratio >= 0.6
                ? 'Bom trabalho. Releia as explicações das perguntas que errou para consolidar o raciocínio.'
                : 'Vale revisar os módulos anteriores e tentar o caso novamente.';
          } else {
            sumResult.hidden = true;
            sumStatus.hidden = false;
            sumStatus.textContent =
              done === 0
                ? 'Responda às perguntas para ver o seu resultado.'
                : `Você respondeu ${done} de ${total} perguntas. Responda às demais para ver o resultado.`;
          }
        }

        function renderAll() {
          questions.forEach((_, i) => renderChip(i));
          renderSummary();
        }

        function unlock(i) {
          const q = questions[i];
          if (!q || q.dataset.locked !== 'true') return;
          q.dataset.locked = 'false';
          q.querySelector('[data-locked-note]').hidden = true;
          q.querySelector('[data-body]').hidden = false;
          live.textContent = `Pergunta ${i + 1} liberada.`;
        }

        function goTo(target) {
          target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
          target.focus({ preventScroll: true });
          history.replaceState(null, '', `#${target.id}`);
        }

        function answer(opt) {
          const q = opt.closest('[data-question]');
          if (q.dataset.answered || q.dataset.locked === 'true') return;
          q.dataset.answered = 'true';

          const i = questions.indexOf(q);
          const correct = q.dataset.correct;
          const isRight = opt.dataset.letter === correct;

          q.querySelectorAll('[data-option]').forEach((o) => {
            const badge = o.querySelector('[data-badge]');
            const status = o.querySelector('[data-status]');
            o.setAttribute('aria-disabled', 'true');
            o.classList.remove('hover:border-teal-400', 'hover:bg-teal-50', 'border-slate-200', 'bg-white');
            o.classList.add('cursor-default');
            if (o.dataset.letter === correct) {
              o.classList.add(...CORRECT_OPT);
              badge.classList.remove('bg-slate-100', 'text-slate-700');
              badge.classList.add(...CORRECT_BADGE);
              status.textContent = 'Resposta correta';
              status.classList.add('text-emerald-700');
              status.hidden = false;
            } else if (o === opt) {
              o.classList.add(...WRONG_OPT);
              badge.classList.remove('bg-slate-100', 'text-slate-700');
              badge.classList.add(...WRONG_BADGE);
              status.textContent = 'Sua resposta';
              status.classList.add('text-red-700');
              status.hidden = false;
            } else {
              o.classList.add('border-slate-200', 'bg-white', 'opacity-60');
            }
            if (o === opt) o.setAttribute('aria-pressed', 'true');
          });

          const fb = q.querySelector('[data-feedback]');
          fb.classList.remove('border-slate-200', 'bg-slate-50');
          fb.classList.add(...(isRight ? FB_OK : FB_BAD));
          q.querySelector('[data-feedback-title]').textContent = isRight ? 'Resposta correta!' : 'Resposta incorreta.';
          fb.hidden = false;

          results[i] = isRight ? 'correct' : 'wrong';
          done += 1;
          if (isRight) score += 1;
          unlock(i + 1);
          renderAll();

          fb.focus({ preventScroll: true });
          fb.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'nearest' });
        }

        function restart() {
          questions.forEach((q, i) => {
            delete q.dataset.answered;
            q.querySelectorAll('[data-option]').forEach((o) => {
              const o0 = original.get(o);
              o.className = o0.opt;
              o.querySelector('[data-badge]').className = o0.badge;
              o.removeAttribute('aria-disabled');
              o.removeAttribute('aria-pressed');
              const status = o.querySelector('[data-status]');
              status.hidden = true;
              status.textContent = '';
              status.className = 'shrink-0 text-sm font-semibold pt-1';
            });
            const fb = q.querySelector('[data-feedback]');
            fb.className = original.get(fb).opt;
            fb.hidden = true;
            if (q.dataset.lockable === 'true') {
              q.dataset.locked = 'true';
              q.querySelector('[data-locked-note]').hidden = false;
              q.querySelector('[data-body]').hidden = true;
            }
            results[i] = null;
          });
          score = 0;
          done = 0;
          renderAll();
          window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
        }

        // Pergunta em foco na rolagem: destaca o número correspondente no navegador.
        let ticking = false;
        function onScroll() {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            ticking = false;
            let idx = -1;
            questions.forEach((q, i) => {
              if (q.getBoundingClientRect().top <= 190) idx = i;
            });
            if (idx !== active) {
              active = idx;
              questions.forEach((_, i) => renderChip(i));
              if (idx >= 0) chips[idx].scrollIntoView({ block: 'nearest', inline: 'nearest' });
            }
          });
        }
        window.addEventListener('scroll', onScroll, { passive: true });

        root.addEventListener('click', (e) => {
          const go = e.target.closest('[data-goto]');
          if (go) {
            const target = document.querySelector(go.getAttribute('href'));
            if (target) {
              e.preventDefault();
              goTo(target);
            }
            return;
          }
          const opt = e.target.closest('[data-option]');
          if (opt) { answer(opt); return; }
          if (e.target.closest('[data-restart]')) restart();
        });

        renderAll();
        onScroll();
      }
    </script>
  </body>
</html>
