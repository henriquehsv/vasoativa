---
import '../styles/global.css';
import { prateleira } from '../data/prateleira.js';

const navLinks = [
  { name: "Início", href: "/" },
  { name: "Conteúdo", href: "/#conteudo" },
  { name: "Casos Clínicos", href: "/modulo/9" },
  { name: "Cálculo de Dose", href: "/calculadora" },
  { name: "Fármacos Vasoativos", href: "/farmacos" },
];

const titulo = "Fármacos vasoativos";

// Área clicável: o contorno aparece ao passar o mouse ou focar com o teclado.
const area = "absolute rounded-[14px] border-[3px] border-transparent cursor-pointer transition-colors focus:outline-none";
const ativa = "hover:border-teal-600 hover:bg-teal-600/10 focus-visible:border-teal-600 focus-visible:bg-teal-600/10";
const pendente = "cursor-default hover:border-slate-400 hover:bg-slate-400/10 focus-visible:border-slate-400 focus-visible:bg-slate-400/10";
const pos = (a) => `left:${a[0]}%;top:${a[1]}%;width:${a[2]}%;height:${a[3]}%`;
const btnBarra = "text-sm font-semibold text-white border border-white/50 hover:bg-white/10 rounded-lg px-3 py-1.5 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white";
---

<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{titulo} - VASOATIVA</title>
    <meta name="description" content="Modelos de prescrição de noradrenalina, vasopressina, dobutamina, nitroprussiato de sódio e nitroglicerina." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-slate-50 font-['Inter',sans-serif] text-slate-800 antialiased min-h-screen">
    <!-- NAVIGATION -->
    <header class="bg-white border-b border-slate-100 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
          <span class="text-2xl font-bold tracking-tight text-slate-900">
            VASO<span class="text-teal-600">ATIVA</span>
          </span>
          <span class="hidden lg:inline-block text-xs font-semibold tracking-wider text-teal-700 bg-teal-50 px-2.5 py-1 rounded-full uppercase ml-2">
            Educação em Saúde
          </span>
        </a>

        <nav class="hidden md:flex items-center gap-5 lg:gap-8 whitespace-nowrap text-sm font-medium text-slate-600">
          {navLinks.map((link) => (
            <a href={link.href} class="hover:text-teal-600 transition-colors py-2 border-b-2 border-transparent hover:border-teal-600">
              {link.name}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-20">
      <a
        href="/#conteudo"
        class="inline-block text-sm font-semibold text-teal-700 hover:text-teal-800 hover:underline focus-visible:outline-2 focus-visible:outline-teal-600 focus-visible:outline-offset-4 mb-6"
      >
        ← Todos os módulos
      </a>

      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight mb-3">
        {titulo}
      </h1>
      <p class="text-lg text-slate-600 leading-relaxed mb-8">
        Clique em uma droga da prateleira para abrir o modelo de prescrição.
      </p>

      <!-- PRATELEIRA: áreas em % da imagem, para acompanhar qualquer largura de tela -->
      <div data-prateleira class="relative w-full aspect-[3/2] rounded-2xl overflow-hidden shadow-md bg-white">
        <img
          src="/prateleira/prateleira.webp"
          width="1536"
          height="1024"
          alt="Prateleira com seis fármacos vasoativos: noradrenalina, vasopressina, adrenalina, dobutamina, nitroprussiato de sódio e nitroglicerina."
          class="w-full h-full"
        />
        {prateleira.map((d) => d.pdf ? (
          <a
            href={d.pdf}
            target="_blank"
            rel="noopener"
            data-area
            data-pdf={d.pdf}
            data-rotulo={d.rotulo}
            aria-label={`Abrir prescrição: ${d.rotulo}`}
            class={`${area} ${ativa}`}
            style={pos(d.area)}
          ></a>
        ) : (
          <button
            type="button"
            data-area
            data-pendente
            data-rotulo={d.rotulo}
            aria-disabled="true"
            aria-label={`${d.rotulo} (prescrição em preparação)`}
            class={`${area} ${pendente}`}
            style={pos(d.area)}
          ></button>
        ))}
      </div>
    </main>

    <div
      data-aviso
      role="status"
      aria-live="polite"
      class="fixed left-1/2 bottom-6 -translate-x-1/2 max-w-[calc(100%-2rem)] bg-slate-900 text-white text-sm rounded-lg px-4 py-2.5 shadow-lg opacity-0 pointer-events-none transition-opacity"
    ></div>

    <!-- VISOR DO PDF (computador) -->
    <dialog
      data-visor
      aria-labelledby="visor-titulo"
      class="m-auto w-[min(960px,96vw)] h-[min(92vh,1200px)] p-0 rounded-2xl overflow-hidden backdrop:bg-slate-900/60"
    >
      <div class="flex items-center gap-3 bg-slate-900 text-white px-4 py-2.5">
        <h2 id="visor-titulo" class="flex-1 text-base font-semibold"></h2>
        <a data-visor-link href="#" target="_blank" rel="noopener" class={btnBarra}>Abrir em nova aba</a>
        <button type="button" data-visor-fechar class={btnBarra}>Fechar</button>
      </div>
      <iframe data-visor-pdf title="Modelo de prescrição" class="w-full h-[calc(100%-3.25rem)] bg-white"></iframe>
    </dialog>

    <script>
      const visor = document.querySelector('[data-visor]') as HTMLDialogElement;
      const titulo = document.getElementById('visor-titulo')!;
      const link = document.querySelector('[data-visor-link]') as HTMLAnchorElement;
      const quadro = document.querySelector('[data-visor-pdf]') as HTMLIFrameElement;
      const aviso = document.querySelector('[data-aviso]') as HTMLElement;
      const areas = document.querySelectorAll<HTMLElement>('[data-area]');

      // ?debug no endereço contorna todas as áreas, para conferir o alinhamento.
      if (new URLSearchParams(location.search).has('debug')) {
        areas.forEach((a) => a.classList.add('!border-red-600'));
      }

      // No celular o PDF abre em nova aba (comportamento padrão do link).
      const celular = () => window.matchMedia('(max-width: 700px)').matches;

      let avisoTimer: number | undefined;
      function avisar(texto: string) {
        aviso.textContent = texto;
        aviso.classList.replace('opacity-0', 'opacity-100');
        clearTimeout(avisoTimer);
        avisoTimer = window.setTimeout(() => aviso.classList.replace('opacity-100', 'opacity-0'), 2800);
      }

      areas.forEach((a) => {
        a.addEventListener('click', (e) => {
          const rotulo = a.dataset.rotulo!;
          if (a.dataset.pendente !== undefined) {
            avisar(`${rotulo}: prescrição em preparação.`);
            return;
          }
          if (celular() || typeof visor.showModal !== 'function') return;
          e.preventDefault();
          titulo.textContent = rotulo;
          link.href = a.dataset.pdf!;
          quadro.src = a.dataset.pdf!;
          visor.showModal();
        });
      });

      visor.querySelector('[data-visor-fechar]')!.addEventListener('click', () => visor.close());
      visor.addEventListener('close', () => { quadro.src = 'about:blank'; });
      visor.addEventListener('click', (e) => { if (e.target === visor) visor.close(); });
    </script>
  </body>
</html>
