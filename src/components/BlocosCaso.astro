---
// Renderiza os blocos de um caso clínico (parágrafos, dados vitais, listas e imagens).
const { blocos = [] } = Astro.props;
const fmt = (s) => s.replace(/\*(.+?)\*/g, '<em>$1</em>');
---

{blocos.map((b) => {
  if (b.tipo === 'p') {
    return <p class="text-lg text-slate-700 leading-relaxed mb-4 last:mb-0" set:html={fmt(b.texto)} />;
  }
  if (b.tipo === 'dados') {
    return (
      <dl class="grid grid-cols-2 sm:grid-cols-4 gap-3 my-5">
        {b.itens.map(([rotulo, valor]) => (
          <div class="bg-slate-50 border border-slate-100 rounded-xl px-4 py-3">
            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">{rotulo}</dt>
            <dd class="mt-1 font-bold text-slate-900 leading-snug">{valor}</dd>
          </div>
        ))}
      </dl>
    );
  }
  if (b.tipo === 'ul') {
    return (
      <ul class="mb-4 last:mb-0 space-y-1.5 text-lg text-slate-700 leading-relaxed list-disc pl-6 marker:text-teal-600">
        {b.itens.map((i) => <li>{i}</li>)}
      </ul>
    );
  }
  if (b.tipo === 'img') {
    return (
      <figure class="my-6">
        <div class="bg-white p-2 rounded-2xl border border-slate-100 shadow-sm max-w-xl mx-auto">
          <img src={b.src} width={b.w} height={b.h} alt={b.alt} loading="lazy" class="w-full h-auto rounded-lg" />
        </div>
        {b.fonte && <figcaption class="mt-2 max-w-xl mx-auto text-sm text-slate-500 leading-relaxed">{b.fonte}</figcaption>}
      </figure>
    );
  }
  return null;
})}
